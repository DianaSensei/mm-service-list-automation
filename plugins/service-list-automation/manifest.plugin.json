{
  "kind": "plugin",
  "id": "service-list-automation",
  "version": "0.0.0",
  "sdk": "^1.0.0",
  "entry": "REPLACED_BY_CI",
  "integrity": "REPLACED_BY_CI",
  "label": "Service List",
  "description": "Fill the merchant service-list form from a CSV, driving a Chrome session you log in to yourself.",
  "icon": "list-checks",
  "keywords": [
    "service list",
    "merchant",
    "csv",
    "automation",
    "chrome",
    "form",
    "bulk",
    "import",
    "apex"
  ],
  "route": "/service-list-automation",
  "permissions": [
    "storage",
    "files:read",
    "service"
  ],
  "commands": [],
  "hosts": [],
  "service": {
    "bin": "devtool-svc-service-list-automation",
    "methods": [
      "launch-chrome",
      "close-chrome",
      "session-status",
      "parse-csv",
      "run-batch",
      "cancel-batch",
      "profile-info"
    ]
  }
}
